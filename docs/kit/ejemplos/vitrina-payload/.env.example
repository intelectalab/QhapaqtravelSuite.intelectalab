# Base propia del CMS (no la de KipuControl). Rol con permisos solo sobre el esquema `payload`.
DATABASE_URI=postgres://payload_role:CAMBIAR@db:5432/rutaslibres_cms
PAYLOAD_SECRET=generar-32-bytes-aleatorios
NEXT_PUBLIC_SITE_URL=https://rutaslibres.pe
APP_ENV=production

# KipuControl: lectura de tours y webhook firmado (BLG-03). El secreto vive en el vault.
KIPU_API_URL=https://api.kipucontrol.com
KIPU_WEBHOOK_URL=https://api.kipucontrol.com/api/v1/platform/blog/webhooks/payload
KIPU_WEBHOOK_SECRET=

# Imágenes (S3 o compatible)
S3_BUCKET=rutaslibres-media
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_HOST=media.rutaslibres.pe

# IndexNow (BLG-06)
INDEXNOW_KEY=
