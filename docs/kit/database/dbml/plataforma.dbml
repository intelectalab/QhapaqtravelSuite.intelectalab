// Plataforma (tablas sin tenant / sin RLS de tenant) — 30 tablas. Solo refs internas a la fase.


Table platform_users {
  id uuid [pk, not null]
  name varchar(150) [not null]
  email varchar(190) [not null]
  password varchar(255) [not null]
  mfa_secret text [not null]
  status varchar(20) [not null, note: 'in (activo, inactivo)']
  last_login_at timestamptz
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: '00 §3.1 · Usuarios de plataforma (Super Admin). Guard `platform`; nunca tienen filas en iam_users.'
}

Table plans {
  id uuid [pk, not null]
  code varchar(30) [not null]
  name varchar(60) [not null]
  rank smallint [not null]
  price_month numeric(14,2) [not null]
  price_year numeric(14,2) [not null]
  currency char(3) [not null]
  trial_days smallint [not null]
  support_level varchar(80)
  module_count smallint
  status varchar(30) [not null, note: 'in (active, hidden, retired)']
  gateway_price_ids jsonb
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: '13 §3.2 + 09 §3.1 · Planes comerciales (Starter/Professional/Enterprise).'
}

Table plan_limits {
  plan_id uuid [not null]
  metric varchar(30) [not null, note: 'in (users, sedes, storage_gb, reservations_month, whatsapp_month, email_month, api_calls_month, api_rate_per_min, webhooks, api_keys)']
  value bigint
  hard boolean [not null]
  indexes {
    (plan_id, metric) [pk]
  }
  Note: '13 §3.3 · Límites por plan y métrica (NULL = ilimitado).'
}

Table addons {
  code varchar(40) [pk, not null]
  label varchar(120) [not null]
  unit varchar(30)
  quantity_allowed boolean [not null]
  price_month numeric(14,2)
  available_plans uuid[] [not null]
  included_plans uuid[] [not null]
  grants jsonb [not null]
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  billing_mode varchar(8) [not null]
  price_once numeric(14,2)
  Note: '13 §3.5 · Catálogo de add-ons de suscripción.'
}

Table addon_prices {
  addon_code varchar(40) [not null]
  plan_id uuid [not null]
  price numeric(14,2) [not null]
  indexes {
    (addon_code, plan_id) [pk]
  }
  Note: '13 §3.5 · Precio de add-on por plan (p. ej. extra_users).'
}

Table features {
  key varchar(60) [pk, not null]
  label varchar(120) [not null]
  module varchar(40)
  kind varchar(20) [not null, note: 'in (module, limit, addon, beta)']
  addon_code varchar(40)
  routes "text[]" [not null]
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  Note: '13 §3.4 · Catálogo de feature flags / módulos.'
}

Table plan_features {
  plan_id uuid [not null]
  feature_key varchar(60) [not null]
  value varchar(30) [not null]
  label varchar(120)
  indexes {
    (plan_id, feature_key) [pk]
  }
  Note: '13 §3.4 + 09 §3.2 · Matriz plan × feature (entitlements).'
}

Table plan_channels {
  channel_key varchar(30) [pk, not null]
  label varchar(80) [not null]
  min_plan_id uuid [not null]
  description varchar(200) [not null]
  depends_on_integration varchar(30)
  Note: '09 §3.3 · Canal mínimo por plan (CHANNELS del prototipo).'
}

Table tenants {
  id uuid [pk, not null]
  code varchar(20) [not null]
  legal_name varchar(200) [not null]
  commercial_name varchar(120) [not null]
  ruc char(11) [not null]
  fiscal_address varchar(250) [not null]
  business_type varchar(40) [not null, note: 'in (Agencia de viajes minorista, Agencia mayorista, Operador turístico, DMC / receptivo, Agencia corporativa)']
  legal_rep varchar(150)
  subdomain varchar(30) [not null]
  custom_domain varchar(190)
  country varchar(40) [not null]
  base_currency char(3) [not null]
  alt_currency char(3) [not null]
  timezone varchar(40) [not null]
  locale varchar(10) [not null]
  logo_initials varchar(3) [not null]
  logo_path varchar(255)
  plan_id uuid [not null]
  status varchar(20) [not null, note: 'in (prueba, activo, suspendido)']
  trial_ends_at timestamptz
  suspend_reason text
  suspended_at timestamptz
  mrr numeric(14,2) [not null]
  modules smallint [not null]
  storage_used_bytes bigint [not null]
  admin_email varchar(190) [not null]
  settings jsonb [not null]
  created_by uuid
  lock_version integer [not null]
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: '09 §3.4 · Tenant (agencia). Raíz del aislamiento; RLS propia: una fila visible = la del contexto.'
}

Table tenant_onboarding {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  payload jsonb [not null]
  permission_template varchar(40) [not null, note: 'in (estandar, minimo_privilegio, copiar_tenant)']
  copied_from_tenant_id uuid
  idempotency_key varchar(80) [not null]
  created_by uuid
  created_at timestamptz [not null]
  Note: '09 §3.5 · Snapshot del asistente de alta PROC-001.'
}

Table platform_sequences {
  id uuid [pk, not null]
  doc_type varchar(40) [not null]
  series varchar(10) [not null]
  prefix varchar(30) [not null]
  pad_width smallint [not null]
  next_number bigint [not null]
  Note: '13 §3.8 · Correlativos globales de plataforma (series FQ01/NQ01, TNT-, SUB-).'
}

Table feature_overrides {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  feature_key varchar(60) [not null]
  value boolean [not null]
  reason varchar(300) [not null]
  valid_until date
  granted_by uuid [not null]
  created_by uuid
  created_at timestamptz [not null]
  Note: '13 §3.4 · Excepciones de feature por tenant (Super Admin).'
}

Table sys_booking_rule_catalog {
  id uuid [pk, not null]
  code varchar(40) [not null]
  rule_group varchar(40) [not null]
  name varchar(160) [not null]
  description text [not null]
  default_enabled boolean [not null]
  default_params jsonb [not null]
  params_schema jsonb [not null]
  scope "text[]" [not null]
  product_override boolean [not null]
  min_plan varchar(20) [not null, note: 'in (Starter, Professional, Enterprise)']
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: '17 §3.1 + 16 §3.1 + 13 §3.4 · Catálogo de plataforma de reglas del motor de reservas (31 reglas).'
}

Table plan_rule_entitlements {
  rule_code varchar(40) [pk, not null]
  min_plan varchar(20) [not null, note: 'in (Starter, Professional, Enterprise)']
  is_demo boolean [not null]
  updated_by uuid
  updated_at timestamptz [not null]
  Note: '13 §3.4 (v2.2) · Plan mínimo que incluye cada regla del motor (DEMO editable).'
}

Table sys_rule_templates {
  id uuid [pk, not null]
  code varchar(30) [not null, note: 'in (receptivo,minorista,aventura,b2b)']
  name varchar(120) [not null]
  description text
  enabled_codes "text[]" [not null]
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: '17 §3.3 · Plantillas de reglas por tipo de negocio (plataforma).'
}

Table permissions {
  id uuid [pk, not null]
  name varchar(125) [not null]
  guard_name varchar(125) [not null]
  module varchar(40) [not null]
  description varchar(200)
  Note: '00 §3.5 · Catálogo global de permisos (spatie). Sin tenant; sembrado por seeder.'
}

Table coupons {
  id uuid [pk, not null]
  code varchar(20) [not null]
  type varchar(10) [not null, note: 'in (percent, fixed)']
  value numeric(10,2) [not null]
  duration_cycles smallint [not null]
  plan_ids "uuid[]" [not null]
  max_redemptions integer
  redeemed_count integer [not null]
  valid_to date
  status varchar(10) [not null, note: 'in (active, inactive)']
  note text
  created_by uuid
  created_at timestamptz [not null]
  Note: '13 §3.9 · Cupones de suscripción. [Fase 3]'
}

Table subscriptions {
  id uuid [pk, not null]
  code varchar(30) [not null]
  tenant_id uuid [not null]
  plan_id uuid [not null]
  cycle varchar(10) [not null, note: 'in (monthly, annual)']
  status varchar(30) [not null, note: 'in (trialing, active, past_due, cancel_scheduled, suspended, canceled)']
  trial_starts_at date
  trial_ends_at date
  trial_extended_days smallint [not null]
  current_period_start date [not null]
  current_period_end date [not null]
  billing_anchor_day smallint [not null]
  auto_renew boolean [not null]
  cancel_at date
  cancel_survey jsonb
  credit_balance numeric(14,2) [not null]
  coupon_redemption_id uuid
  gateway varchar(20) [not null, note: 'in (cashier_stripe,local_gateway)']
  gateway_customer_id varchar(100)
  gateway_subscription_id varchar(100)
  billing_ruc char(11) [not null]
  billing_name varchar(200) [not null]
  billing_address varchar(200) [not null]
  billing_ubigeo char(6)
  billing_email varchar(150) [not null]
  lock_version integer [not null]
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: '13 §3.6 · Suscripción del tenant a un plan. [Fase 3]'
}

Table coupon_redemptions {
  id uuid [pk, not null]
  coupon_id uuid [not null]
  tenant_id uuid [not null]
  subscription_id uuid [not null]
  remaining_cycles smallint [not null]
  created_by uuid
  created_at timestamptz [not null]
  Note: '13 §3.9 · Canje de cupón por tenant. [Fase 3]'
}

Table subscription_items {
  id uuid [pk, not null]
  subscription_id uuid [not null]
  addon_code varchar(40) [not null]
  quantity smallint [not null]
  meta jsonb
  starts_at date [not null]
  ends_at date
  unit_price numeric(14,2) [not null]
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  billing_mode varchar(8) [not null]
  paid_once_at timestamptz
  Note: '13 §3.6 · Add-ons contratados en la suscripción. [Fase 3]'
}

Table platform_invoices {
  id uuid [pk, not null]
  series char(4) [not null]
  number integer [not null]
  tenant_id uuid [not null]
  subscription_id uuid [not null]
  kind varchar(20) [not null, note: 'in (subscription, proration, addon, manual)']
  period_from date [not null]
  period_to date [not null]
  issue_date date [not null]
  due_date date [not null]
  currency char(3) [not null]
  subtotal numeric(14,2) [not null]
  igv numeric(14,2) [not null]
  total numeric(14,2) [not null]
  igv_pct numeric(5,2) [not null]
  status varchar(20) [not null, note: 'in (draft, open, paid, failed, uncollectible, void)']
  paid_at timestamptz
  payment_ref varchar(120)
  bill_to jsonb [not null]
  sunat_status varchar(20) [not null, note: 'in (pending, accepted, observed, rejected)']
  sunat_hash varchar(120)
  sunat_cdr_path varchar(255)
  pdf_path varchar(255)
  xml_path varchar(255)
  dunning_failed_at date
  dunning_retries_done smallint [not null]
  dunning_next_retry_at timestamptz
  dunning_extended_days smallint [not null]
  void_reason varchar(300)
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: '13 §3.8 · Facturas de plataforma (emisor KipuControl Cloud). [Fase 3]'
}

Table platform_invoice_lines {
  id uuid [pk, not null]
  invoice_id uuid [not null]
  description varchar(250) [not null]
  quantity numeric(10,2) [not null]
  unit_price numeric(14,2) [not null]
  amount numeric(14,2) [not null]
  line_type varchar(20) [not null, note: 'in (plan, addon, proration_charge, proration_credit, discount, usage_overage)']
  Note: '13 §3.8 · Líneas de factura de plataforma. [Fase 3]'
}

Table subscription_changes {
  id uuid [pk, not null]
  subscription_id uuid [not null]
  kind varchar(20) [not null, note: 'in (upgrade, downgrade, cycle, addon_add, addon_update, addon_remove, cancel, resume)']
  from_plan_id uuid
  to_plan_id uuid
  from_cycle varchar(10)
  to_cycle varchar(10)
  effective_at date [not null]
  status varchar(20) [not null, note: 'in (scheduled, applied, voided)']
  proration jsonb
  invoice_id uuid
  requested_by uuid
  created_by uuid
  created_at timestamptz [not null]
  Note: '13 §3.6 · Cambios de plan/ciclo/add-on (programados o aplicados). [Fase 3]'
}

Table platform_credit_notes {
  id uuid [pk, not null]
  series char(4) [not null]
  number integer [not null]
  invoice_id uuid [not null]
  reason varchar(300) [not null]
  amount numeric(14,2) [not null]
  sunat_status varchar(20) [not null, note: 'in (pending, accepted, observed, rejected)']
  refund_ref varchar(120)
  created_by uuid
  created_at timestamptz [not null]
  Note: '13 §3.8 · Notas de crédito de plataforma (serie NQ01). [Fase 3]'
}

Table payment_methods {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  gateway_token varchar(120) [not null]
  brand varchar(20)
  last4 char(4)
  exp_month smallint
  exp_year smallint
  holder varchar(120)
  is_default boolean [not null]
  status varchar(20) [not null, note: 'in (active, expired, removed)']
  created_by uuid
  created_at timestamptz [not null]
  Note: '13 §3.7 · Medios de pago del tenant para la suscripción (solo token). [Fase 3]'
}

Table payment_attempts {
  id uuid [pk, not null]
  invoice_id uuid [not null]
  attempt_no smallint [not null]
  source varchar(20) [not null, note: 'in (initial, dunning, manual_retry, portal, manual_payment)']
  result varchar(20) [not null, note: 'in (succeeded, declined, error)']
  gateway_code varchar(40)
  message varchar(300)
  idempotency_key varchar(80) [not null]
  created_by uuid
  created_at timestamptz [not null]
  Note: '13 §3.8 · Intentos de cobro de facturas de plataforma (dunning). [Fase 3]'
}

Table usage_counters {
  tenant_id uuid [not null]
  metric varchar(30) [not null, note: 'in (users, sedes, storage_gb, reservations_month, whatsapp_month, email_month, api_calls_month, api_rate_per_min, webhooks, api_keys)']
  day date [not null]
  value bigint [not null]
  indexes {
    (tenant_id, metric, day) [pk]
  }
  Note: '13 §3.10 · Contadores diarios de uso por tenant (particionada por mes). [Fase 3]'
}

Table usage_monthly {
  tenant_id uuid [not null]
  metric varchar(30) [not null]
  month date [not null]
  value bigint [not null]
  limit_value bigint
  alert_80_sent_at timestamptz
  alert_100_sent_at timestamptz
  indexes {
    (tenant_id, metric, month) [pk]
  }
  Note: '13 §3.10 · Uso mensual consolidado y alertas 80/100 %. [Fase 3]'
}

Table usage_events {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  metric varchar(30) [not null]
  day date [not null]
  value bigint [not null]
  processed_at timestamptz
  created_at timestamptz [not null]
  Note: '13 §9 (fallback) · Fallback de medición cuando Redis no está disponible. [Fase 3] (supuesto: columnas mínimas)'
}

Table platform_metrics_daily {
  id uuid [pk, not null]
  day date [not null]
  mrr numeric(14,2) [not null]
  arr numeric(14,2) [not null]
  arpa numeric(14,2) [not null]
  active_tenants integer [not null]
  new_tenants integer [not null]
  churned_tenants integer [not null]
  logo_churn_pct numeric(6,3)
  revenue_churn_pct numeric(6,3)
  breakdown jsonb [not null]
  Note: '13 §3.1 · Snapshot diario de MRR/ARR/churn. [Fase 3] (supuesto: columnas)'
}

Ref: plan_limits.plan_id > plans.id
Ref: addon_prices.addon_code > addons.code
Ref: addon_prices.plan_id > plans.id
Ref: features.addon_code > addons.code
Ref: plan_features.plan_id > plans.id
Ref: plan_features.feature_key > features.key
Ref: plan_channels.min_plan_id > plans.id
Ref: tenants.plan_id > plans.id
Ref: tenants.created_by > platform_users.id
Ref: tenant_onboarding.copied_from_tenant_id > tenants.id
Ref: feature_overrides.feature_key > features.key
Ref: feature_overrides.granted_by > platform_users.id
Ref: plan_rule_entitlements.rule_code > sys_booking_rule_catalog.code
Ref: plan_rule_entitlements.updated_by > platform_users.id
Ref: coupons.created_by > platform_users.id
Ref: subscriptions.plan_id > plans.id
Ref: subscriptions.coupon_redemption_id > coupon_redemptions.id
Ref: coupon_redemptions.coupon_id > coupons.id
Ref: coupon_redemptions.subscription_id > subscriptions.id
Ref: subscription_items.subscription_id > subscriptions.id
Ref: subscription_items.addon_code > addons.code
Ref: platform_invoices.subscription_id > subscriptions.id
Ref: platform_invoice_lines.invoice_id > platform_invoices.id
Ref: subscription_changes.subscription_id > subscriptions.id
Ref: subscription_changes.from_plan_id > plans.id
Ref: subscription_changes.to_plan_id > plans.id
Ref: subscription_changes.invoice_id > platform_invoices.id
Ref: platform_credit_notes.invoice_id > platform_invoices.id
Ref: platform_credit_notes.created_by > platform_users.id
Ref: payment_attempts.invoice_id > platform_invoices.id
