// Fase 2 · Canales y campo — 86 tablas. Solo refs internas a la fase.
// Tablas de fases previas que esta fase amplía (columnas nuevas): booking_passengers, booking_reservation_services, booking_reservations, catalog_product_media, catalog_products, catalog_services, crm_clients, crm_leads, fin_commissions, fin_fx_rates, fin_payables, fin_payments, iam_users, ops_incidents, quote_versions

Table ops_mobile_devices {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  user_id uuid [not null]
  app varchar(20) [not null, note: 'in (operador, pasajero)']
  platform varchar(10) [not null, note: 'in (ios, android)']
  app_version varchar(20) [not null]
  expo_push_token varchar(200)
  last_seen_at timestamptz
  last_sync_at timestamptz
  sync_cursor varchar(64)
  revoked_at timestamptz
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: '05 §3.13 · Dispositivos de las apps operador/pasajero (id generado en el dispositivo).'
}

Table ops_sync_actions {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  user_id uuid [not null]
  device_id uuid [not null]
  resource_type varchar(10) [not null, note: 'in (guide, driver)']
  resource_id uuid [not null]
  action_type varchar(20) [not null, note: 'in (confirm, start, checkin, checkin_undo, checkin_all, evidence, incident, finish)']
  assignment_id uuid [not null]
  coalesce_key varchar(120) [not null]
  payload jsonb [not null]
  occurred_at timestamptz [not null]
  captured_offline boolean [not null]
  received_at timestamptz [not null]
  attempts smallint [not null]
  result varchar(20) [not null, note: 'in (applied, duplicate, conflict_resolved, rejected)']
  conflict_rule varchar(40)
  conflict_message text
  response jsonb [not null]
  Note: '05 §3.13 · Acciones recibidas del outbox móvil (base de idempotencia; id = client_action_id).'
}

Table channel_trip_messages {
  id uuid [pk, not null]
