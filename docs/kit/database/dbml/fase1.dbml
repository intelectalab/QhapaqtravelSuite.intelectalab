  penalties text
  refund text [not null]
  date_change text
  advance_min varchar(40)
  advance_max varchar(40)
  penalty_tiers jsonb [not null]
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: '02 §3.7 · Políticas comerciales 1:1 con producto.'
}

Table catalog_product_related {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  product_id uuid [not null]
  related_product_id uuid [not null]
  relation varchar(20) [not null, note: 'in (Complementario, Alternativo, Upgrade, Cross-sell, Upsell)']
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: '02 §3.7 · Productos relacionados (cross-sell/upsell).'
}

Table catalog_seasons {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  ref varchar(20) [not null]
  name varchar(120) [not null]
  type varchar(20) [not null, note: 'in (Alta, Media, Baja, Feriado, Fecha especial, Personalizada)']
  date_from date [not null]
  date_to date [not null]
  priority smallint [not null]
  factor numeric(4,2) [not null]
  status varchar(10) [not null, note: 'in (activa, inactiva)']
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
