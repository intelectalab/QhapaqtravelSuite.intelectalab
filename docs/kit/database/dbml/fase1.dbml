// Fase 1 · MVP — 93 tablas. Solo refs internas a la fase.


Table catalog_product_types {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  name varchar(60) [not null]
  requires_itinerary boolean [not null]
  requires_components boolean [not null]
  sort_order smallint [not null]
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
  Note: '02 §3.1 · Tipos de producto (TOUR, EXCURSIÓN, PAQUETE…).'
}

Table catalog_product_categories {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  ref varchar(20) [not null]
  name varchar(80) [not null]
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
  Note: '02 §3.2 · Categorías de producto.'
}

Table catalog_product_subcategories {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  category_id uuid [not null]
  name varchar(80) [not null]
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
  Note: '02 §3.2 · Subcategorías de producto.'
}

Table catalog_destinations {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  ref varchar(20) [not null]
  parent_id uuid
  name varchar(120) [not null]
  type varchar(20) [not null, note: 'in (País, Región, Departamento, Provincia, Ciudad, Zona, Lugar, Atracción, Ruta)']
  level smallint [not null]
  lat numeric(9,6)
  lng numeric(9,6)
  description text
  path text [not null]
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
  Note: '02 §3.3 · Árbol de destinos (País → Atracción/Ruta).'
}

Table catalog_providers {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  ref varchar(20) [not null]
  name varchar(160) [not null]
  type varchar(20) [not null, note: 'in (Hotel, Transporte, Tren, Guía, Conductor, Restaurante, Operador, Actividad, Entrada, Otros)']
  ruc char(11) [not null]
  city varchar(80)
  stars smallint
  contact_name varchar(120) [not null]
  phone varchar(40)
  email varchar(160)
  contract_start date [not null]
  contract_end date [not null]
  currency char(3) [not null, note: 'in (PEN,USD)']
  payment_terms varchar(120)
  status varchar(20) [not null, note: 'in (activo, inactivo, vencido)']
  rating numeric(2,1) [not null]
  rating_note text
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
  Note: '02 §3.4 · Proveedores (hoteles, transporte, guías…).'
}

Table catalog_provider_contacts {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  provider_id uuid [not null]
  name varchar(120) [not null]
  role varchar(80)
  phone varchar(40)
  email varchar(160)
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: '02 §3.4 · Contactos adicionales del proveedor.'
}

Table catalog_services {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  ref varchar(20) [not null]
  provider_id uuid [not null]
  name varchar(200) [not null]
  type varchar(20) [not null, note: 'in (Traslado, Transporte, Tren, Entrada, Guía, Alimentación, Alojamiento, Actividad, Tour, Seguro, Otro)']
  unit varchar(20) [not null, note: 'in (pax, servicio, habitación, noche, vehículo, unidad)']
  cost numeric(14,2) [not null]
  currency char(3) [not null, note: 'in (PEN,USD)']
  capacity integer
  valid_from date [not null]
  valid_to date [not null]
  status varchar(20) [not null, note: 'in (activo, inactivo, vencido)']
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
  scheduled_cost numeric(14,2)
  scheduled_cost_from date
  Note: '02 §3.5 · Servicios de proveedor (componentes de costo).'
}

Table catalog_products {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  ref varchar(20) [not null]
  code varchar(30) [not null]
  sku varchar(40) [not null]
  name varchar(160) [not null]
  internal_name varchar(160) [not null]
  product_type_id uuid [not null]
  category_id uuid [not null]
  subcategory_id uuid
  primary_destination_id uuid [not null]
  status varchar(20) [not null, note: 'in (DRAFT, REVIEW, APPROVED, ACTIVE, SUSPENDED, INACTIVE, ARCHIVED)']
  short_description text
  long_description text
  duration_value numeric(6,1) [not null]
  duration_unit varchar(10) [not null, note: 'in (horas, días, noches)']
  modality varchar(15) [not null, note: 'in (Privado, Compartido, Grupal)']
  main_provider_id uuid
  minimum_passengers smallint [not null]
  maximum_passengers smallint [not null]
  minimum_age smallint [not null]
  maximum_age smallint [not null]
  booking_advance_min_days smallint [not null]
  booking_advance_max_days smallint [not null]
  is_bookable boolean [not null]
  is_quoteable boolean [not null]
  is_b2b boolean [not null]
  is_ecommerce boolean [not null]
  is_featured boolean [not null]
  markup_pct numeric(6,2) [not null]
  availability_model varchar(20) [not null, note: 'in (SIN_CONTROL, CUPOS, CAPACIDAD, POR_PROVEEDOR, POR_ACTIVIDAD, POR_TRANSPORTE, POR_HABITACION, POR_SALIDA, POR_FECHA)']
  availability_capacity integer
  availability_source varchar(10) [not null, note: 'in (interna, externa)']
  features jsonb [not null]
  video_url varchar(500)
  seo_title varchar(120)
  seo_description varchar(320)
  slug varchar(160)
  current_version_id uuid
  attributes jsonb [not null]
  operating_weekdays "smallint[]" [not null]
  cutoff_hours integer
  lock_version integer [not null]
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
  accommodation_enabled boolean [not null]
  accommodation_optional boolean [not null]
  accommodation_currency char(3)
  accommodation_note text
  pickup_required boolean [not null]
  pickup_ask_flight boolean [not null]
  difficulty varchar(30) [note: 'in (facil, moderada, moderada_exigente, exigente)']
  guide_languages "char(2)[]" [not null]
  pickup_text varchar(200)
  rating_avg numeric(3,2)
  rating_count integer [not null]
  Note: '02 §3.6 + 16 §3.3 · Ficha maestra de producto.'
}

Table catalog_product_versions {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  product_id uuid [not null]
  version varchar(10) [not null]
  status varchar(15) [not null, note: 'in (borrador, en_revision, vigente, historica)']
  valid_from date [not null]
  reason text [not null]
  snapshot jsonb [not null]
  created_by uuid
  created_at timestamptz [not null]
  Note: '02 §3.7 · Versiones inmutables del producto (snapshot).'
}

Table catalog_product_destinations {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  product_id uuid [not null]
  destination_id uuid [not null]
  role varchar(10) [not null]
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: '02 §3.7 · Destinos secundarios del producto.'
}

Table catalog_product_items {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  product_id uuid [not null]
  service_id uuid
  component_product_id uuid
  provider_id uuid
  quantity numeric(8,2) [not null]
  unit varchar(20) [not null, note: 'in (pax, servicio, habitación, noche, vehículo, unidad)']
  sort_order smallint [not null]
  is_required boolean [not null]
  is_included boolean [not null]
  unit_cost_override numeric(14,2)
  notes text
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: '02 §3.7 · Componentes del producto (servicio o producto; paquetes).'
}

Table catalog_itineraries {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  product_id uuid [not null]
  name varchar(120) [not null]
  is_default boolean [not null]
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: '02 §3.7 · Itinerario del producto.'
}

Table catalog_itinerary_days {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  itinerary_id uuid [not null]
  day_number smallint [not null]
  title varchar(160) [not null]
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: '02 §3.7 · Días del itinerario.'
}

Table catalog_itinerary_items {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  day_id uuid [not null]
  start_time time
  activity varchar(200) [not null]
  item_type varchar(20) [note: 'in (Traslado, Transporte, Tren, Hotel, Alimentación, Guía, Actividad, Entrada, Libre, Otro)']
  location varchar(160)
  service_id uuid
  note text
  image_ref varchar(300)
  cost numeric(14,2) [not null]
  price numeric(14,2) [not null]
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: '02 §3.7 · Actividades por día del itinerario.'
}

Table catalog_product_inclusions {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  product_id uuid [not null]
  kind varchar(10) [not null, note: 'in (include, exclude)']
  text varchar(200) [not null]
  sort_order smallint [not null]
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: '02 §3.7 · Incluye / no incluye.'
}

Table catalog_product_requirements {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  product_id uuid [not null]
  category varchar(30) [note: 'in (Condición física, Documentos, Nacionalidad, Restricción, Recomendación, Equipamiento, Requisito especial)']
  text varchar(300) [not null]
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: '02 §3.7 · Requisitos del producto.'
}

Table catalog_product_policies {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  product_id uuid [not null]
  cancellation text [not null]
