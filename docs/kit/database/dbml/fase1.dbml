Table crm_catalog_items {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  kind varchar(30) [not null, note: 'in (lead_source, lead_channel, lead_interest, client_segment, lost_reason, discard_reason, case_type, survey_channel, activity_type)']
  code varchar(40) [not null]
  label varchar(120) [not null]
  requires_detail boolean [not null]
  sort_order smallint [not null]
  is_active boolean [not null]
  created_by uuid
