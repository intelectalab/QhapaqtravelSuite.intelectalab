Table catalog_rates {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  ref varchar(20) [not null]
  product_id uuid [not null]
  rate_type varchar(15) [not null, note: 'in (Proveedor, Costo, Venta, Retail, B2B, Mayorista, Corporativa, VIP, Promocional, Especial, Grupal)']
  segment varchar(10) [not null, note: 'in (Adulto, Niño, Infante, Pasajero, Grupo)']
  channel varchar(12) [not null, note: 'in (Directo, B2B, Corporativo, E-commerce, Mayorista, Todos)']
  currency char(3) [not null, note: 'in (PEN,USD)']
  price_basis varchar(15) [not null, note: 'in (Por persona, Precio fijo, Por grupo, Por habitación, Por unidad)']
  cost numeric(14,2) [not null]
  price numeric(14,2) [not null]
  min_price numeric(14,2)
  max_price numeric(14,2)
  valid_from date [not null]
  valid_to date [not null]
  season_id uuid
  conditions varchar(300)
  status varchar(10) [not null, note: 'in (vigente, inactiva)']
  lock_version integer [not null]
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: '02 §3.8 · Tarifas del producto por segmento/canal/vigencia.'
}

