  tenant_id uuid [not null]
  code varchar(30) [not null]
  crm_client_id uuid [not null]
  reservation_id uuid
  source varchar(30) [not null, note: 'in (portal_cliente, portal_pasajero)']
  subject varchar(200) [not null]
  category varchar(40) [not null]
  topic varchar(40)
  priority varchar(10) [not null, note: 'in (baja, media, alta)']
  message text [not null]
  status varchar(30) [not null, note: 'in (abierta, en_proceso, resuelta, cerrada)']
  owner_id uuid [not null]
  created_by_user_id uuid [not null]
  first_response_due_at timestamptz
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: '08 §3.12 · Solicitudes desde portal cliente / pasajero.'
}

Table channel_support_ticket_events {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  ticket_id uuid [not null]
  occurred_at timestamptz [not null]
  user_id uuid
  message varchar(500) [not null]
  created_by uuid
  created_at timestamptz [not null]
  Note: '08 §3.12 · Bitácora del ticket (log).'
}

Table report_exports {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  code varchar(20)
  report_name varchar(200) [not null]
  report_key varchar(40) [not null]
  filters jsonb [not null]
  scope varchar(20) [not null, note: 'in (filtered, detailed)']
  format varchar(10) [not null, note: 'in (CSV, XLSX, PDF)']
  rows_count integer
  size_bytes bigint
  file_path varchar(255)
  status varchar(20) [not null, note: 'in (en_cola, procesando, disponible, fallido, expirado)']
  requested_by uuid
  scheduled_job_id uuid
  idempotency_key varchar(80)
  expires_at timestamptz [not null]
  finished_at timestamptz
  created_by uuid
  created_at timestamptz [not null]
  Note: '09 §3.16 · Exportaciones de reportes (PROC-061).'
}

