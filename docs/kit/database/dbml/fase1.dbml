  Note: '02 §3.8 · Temporadas (factor de precio).'
}

Table catalog_product_promotions {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  ref varchar(20) [not null]
  product_id uuid [not null]
  name varchar(120) [not null]
  kind varchar(30) [not null, note: 'in (Precio promocional, Descuento fijo, Descuento %, Promoción por fecha, Descuento por cantidad, Promoción por temporada, Promoción por canal, Código promocional)']
  value numeric(12,2) [not null]
  channel varchar(20) [not null, note: 'in (Todos, Directo, E-commerce, B2B, Corporativo)']
  promo_code varchar(40)
  min_pax smallint
  date_from date [not null]
  date_to date [not null]
  status varchar(10) [not null, note: 'in (activa, inactiva)']
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
  campaign_id uuid
  Note: '02 §3.7 + 08 §3.9 · Promociones por producto (códigos promocionales).'
}

Table catalog_product_media {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  product_id uuid [not null]
  kind varchar(10) [not null, note: 'in (image)']
  storage_path varchar(400) [not null]
  alt_text varchar(200) [not null]
