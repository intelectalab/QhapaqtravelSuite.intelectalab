  status varchar(30) [not null]
  note text
  user_id uuid
  created_by uuid
  created_at timestamptz [not null]
  Note: '07 §3.5 · Historial de estados de pagos, comisiones, comprobantes y CxP.'
}

Table fin_payables {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  code varchar(30) [not null]
  provider_id uuid [not null]
  reservation_id uuid
  reservation_service_id uuid
  kind varchar(20) [not null, note: 'in (servicio, costo_adicional)']
