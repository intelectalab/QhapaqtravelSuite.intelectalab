  tenant_id uuid [not null]
  code varchar(40) [not null]
  label varchar(80) [not null]
  requires_reference boolean [not null]
  is_b2b_credit boolean [not null]
  active boolean [not null]
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: '07 §3.9 · Medios de cobro configurables (PAY_METHODS).'
}

Table fin_receivables {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  code varchar(30) [not null]
  reservation_id uuid [not null]
  client_id uuid [not null]
  kind varchar(20) [not null, note: 'in (anticipo, saldo, cargo, ajuste, penalidad, b2b, total, adelanto, pago_posterior)']
  concept varchar(255) [not null]
  amount numeric(14,2) [not null]
  currency char(3) [not null, note: 'in (PEN,USD)']
  fx_rate numeric(12,6)
  paid_amount numeric(14,2) [not null]
  due_date date [not null]
  status varchar(20) [not null, note: 'in (abierta, parcial, vencida, pagada, cancelada)']
  cancelled_at timestamptz
  cancel_reason text
  last_reminder_at timestamptz
  lock_version integer [not null]
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
  Note: '07 §3.1 · Cuentas por cobrar (obligaciones de cobro).'
}

Table fin_receivable_reminders {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  receivable_id uuid [not null]
  channels varchar(60) [not null]
  sent_by uuid
  sent_at timestamptz [not null]
  balance_at_send numeric(14,2) [not null]
  created_by uuid
  created_at timestamptz [not null]
  Note: '07 §3.2 · Recordatorios de cobro enviados.'
}

Table fin_payments {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  code varchar(30) [not null]
  reservation_id uuid [not null]
  receivable_id uuid
  kind varchar(20) [not null, note: 'in (cobro, reembolso)']
  source varchar(20) [not null, note: 'in (backoffice, reserva, portal_cliente, b2b, ecommerce, sistema)']
  method varchar(40) [not null]
  amount numeric(14,2) [not null]
  currency char(3) [not null, note: 'in (PEN,USD)']
  fx_rate numeric(12,6)
  paid_on date [not null]
  reference varchar(80)
  note text
  evidence_document_id uuid
  status varchar(20) [not null, note: 'in (pendiente, confirmado, aplicado, rechazado, revertido)']
  reject_reason text
  retries smallint [not null]
  reverted_at timestamptz
  reverted_by uuid
  revert_reason text
  registered_by uuid
  reported_by_agency boolean [not null]
  lock_version integer [not null]
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  reversal_request_id uuid
  Note: '07 §3.3 + 08 §3.15 · Pagos recibidos y reembolsos.'
}

Table fin_payment_applications {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  payment_id uuid [not null]
  receivable_id uuid [not null]
  amount numeric(14,2) [not null]
  applied_at timestamptz [not null]
  applied_by uuid
  reversed_at timestamptz
  reversed_by uuid
  created_by uuid
  updated_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: '07 §3.4 · Aplicación / desaplicación de pagos a CxC.'
}

Table fin_status_history {
  id uuid [pk, not null]
  tenant_id uuid [not null]
  entity_type varchar(30) [not null, note: 'in (payment, commission, invoice, payable)']
