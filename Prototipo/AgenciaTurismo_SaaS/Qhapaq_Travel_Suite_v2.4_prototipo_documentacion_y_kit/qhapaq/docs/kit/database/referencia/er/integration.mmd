erDiagram
  integration_adapters {
    uuid id PK
    uuid tenant_id UK
    varchar code UK
    varchar name
    varchar kind
    varchar status
    uuid owner_user_id FK
  }
  integration_api_keys {
    uuid id PK
    uuid tenant_id UK
    varchar code UK
    varchar name
    varchar prefix UK
    varchar status
    uuid revoked_by FK
  }
  integration_errors {
    uuid id PK
    varchar code
    varchar status
    uuid resolved_by FK
  }
  integration_oauth_apps {
    uuid id PK
    uuid client_id FK,UK
    varchar status
  }
  integration_review_sources {
    uuid id PK
    uuid tenant_id UK
    varchar provider UK
    varchar status
    uuid connected_by FK
    uuid contract_ack_by FK
  }
  integration_webhook_deliveries {
    uuid id PK
    varchar code
    uuid webhook_id FK
    varchar status
    timestamptz created_at PK
  }
  integration_webhooks {
    uuid id PK
    uuid tenant_id UK
    varchar code UK
    varchar status
  }
  oauth_clients {
    uuid id PK
    varchar name
  }
  iam_users {
    uuid id PK
  }
  iam_users |o--o{ integration_adapters : "owner_user_id"
  iam_users |o--o{ integration_api_keys : "revoked_by"
  iam_users |o--o{ integration_errors : "resolved_by"
  iam_users |o--o{ integration_review_sources : "connected_by, contract_ack_by"
  integration_webhooks ||--o{ integration_webhook_deliveries : "webhook_id"
  oauth_clients ||--o| integration_oauth_apps : "client_id"
