APP_NAME="KipuControl"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://__DOMINIO__
SITES_DOMAIN=__DOMINIO__
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC
TENANCY_CENTRAL_DOMAIN=__DOMINIO__
APP_FROZEN_TODAY=

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kipucontrol
DB_USERNAME=kipucontrol_app
DB_PASSWORD=__DB_APP_PASSWORD__
DB_PLATFORM_USERNAME=kipucontrol_platform
DB_PLATFORM_PASSWORD=__DB_PLATFORM_PASSWORD__
DB_OWNER_USERNAME=kipucontrol_owner
DB_OWNER_PASSWORD=__DB_OWNER_PASSWORD__

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__REDIS_PASSWORD__
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
HORIZON_PREFIX=kipucontrol_horizon:

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=__STORAGE_ACCESS_KEY__
AWS_SECRET_ACCESS_KEY=__STORAGE_SECRET_KEY__
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=kipucontrol-private
AWS_PUBLIC_BUCKET=kipucontrol-public
AWS_ENDPOINT=http://storage:9000
AWS_URL=https://__DOMINIO__/almacen/kipucontrol-private
AWS_TEMPORARY_URL=https://__DOMINIO__/almacen
AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=platform
MAIL_PLATFORM_FALLBACK=log
MAIL_FROM_ADDRESS=no-reply@__DOMINIO__
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=kipucontrol
REVERB_APP_KEY=__REVERB_APP_KEY__
REVERB_APP_SECRET=__REVERB_APP_SECRET__
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

SANCTUM_STATEFUL_DOMAINS=__DOMINIO__
SESSION_DOMAIN=__DOMINIO__
SESSION_SECURE_COOKIE=true
FRONTEND_URL=https://__DOMINIO__
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXIES=172.31.230.0/24

FISCAL_GATEWAY=fake
PAYMENT_GATEWAY=fake
MESSAGING_CHANNEL=fake
REVIEWS_PROVIDER=fake
FX_RATE_PROVIDER=fake
ANTIVIRUS_PROVIDER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
PUSH_PROVIDER=fake

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DEMO_PASSWORD="__DEMO_PASSWORD__"
DEMO_TOTP_SECRET=__DEMO_TOTP_SECRET__
