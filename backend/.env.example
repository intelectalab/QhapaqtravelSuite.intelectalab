# backend/.env — entorno LOCAL. Nunca subir .env con secretos reales al repositorio.
APP_NAME="KipuControl"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
SITES_DOMAIN=localhost
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC
# Dominio raíz para resolver el tenant por subdominio (andes.localhost → TNT-0001)
TENANCY_CENTRAL_DOMAIN=localhost
# Fecha de negocio congelada (solo pruebas E2E); vacío = fecha real
APP_FROZEN_TODAY=

# PostgreSQL 17 — la API conecta SIEMPRE con kipucontrol_app (sin BYPASSRLS)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kipucontrol
DB_USERNAME=kipucontrol_app
DB_PASSWORD=app_local_only
# Conexión de plataforma (Super Admin, facturación SaaS, jobs multi-tenant)
DB_PLATFORM_USERNAME=kipucontrol_platform
DB_PLATFORM_PASSWORD=platform_local_only
# Conexión de migraciones (dueño del esquema). Solo `php artisan migrate --database=pgsql_owner`
DB_OWNER_USERNAME=kipucontrol_owner
DB_OWNER_PASSWORD=owner_local_only

# Redis 8
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
HORIZON_PREFIX=kipucontrol_horizon:

# Archivos (S3 → RustFS en local)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=storage
AWS_SECRET_ACCESS_KEY=storage_local_only
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=kipucontrol-private
AWS_PUBLIC_BUCKET=kipucontrol-public
AWS_ENDPOINT=http://storage:9000
AWS_PRESIGN_ENDPOINT=
AWS_URL=http://localhost:9000/kipucontrol-private
AWS_USE_PATH_STYLE_ENDPOINT=true

# Correo (Mailpit en local)
MAIL_MAILER=platform
MAIL_PLATFORM_FALLBACK=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@kipucontrol.local
MAIL_FROM_NAME="${APP_NAME}"

# Tiempo real (Reverb)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=kipucontrol-local
REVERB_APP_KEY=kipucontrol-local-key
REVERB_APP_SECRET=kipucontrol-local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Sanctum / CORS
SANCTUM_STATEFUL_DOMAINS=localhost:3000,*.localhost:3000
SESSION_DOMAIN=.localhost
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXIES=

# Integraciones — en desarrollo SIEMPRE adaptadores Fake (no inventar credenciales)
FISCAL_GATEWAY=fake          # OSE/PSE SUNAT (spec 07)
PAYMENT_GATEWAY=fake         # pasarela e-commerce (spec 15)
MESSAGING_CHANNEL=fake       # WhatsApp/SMS (spec 10)
REVIEWS_PROVIDER=fake        # TripAdvisor/Trustpilot/Google (spec 17)
FX_RATE_PROVIDER=fake        # tipo de cambio (spec 17; tasas demo en seeds)
ANTIVIRUS_PROVIDER=fake      # adjuntos (INB-BR-11, DOC-BR-013): fake | clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
PUSH_PROVIDER=fake           # Expo push (spec 05)

# Observabilidad
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# Datos de ejemplo (solo local y pruebas): mismos valores de prueba que docs/kit/tests/e2e
DEMO_PASSWORD="KipuControl#E2E-2026"
DEMO_TOTP_SECRET=JBSWY3DPEHPK3PXP
