# web/.env.local — entorno LOCAL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# URL interna (SSR dentro de Docker)
API_INTERNAL_URL=http://nginx/api/v1
NEXT_PUBLIC_APP_DOMAIN=localhost
NEXT_PUBLIC_DEFAULT_LOCALE=es
NEXT_PUBLIC_LOCALES=es,en
NEXT_PUBLIC_REVERB_APP_KEY=kipucontrol-local-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
# Sitio público: revalidación ISR (segundos)
SITE_REVALIDATE_SECONDS=300

# Agencia por defecto cuando se entra sin subdominio (solo desarrollo local)
DEFAULT_TENANT_SLUG=andes

# Dominio propio de la vitrina Rutas Libres (producción: rutaslibres.pe). Vacío en desarrollo: se sirve en /vitrina
SHOWCASE_DOMAIN=
